# Copy to `.dev.vars` for local development. Never commit `.dev.vars`.
# In production these are Wrangler secrets, not file-based:
#   wrangler secret put SESSION_KEY
#
# There is deliberately no ERPNext API key here. Phase 6c removed it: every
# request now runs on the signed-in user's own token, so ERPNext applies that
# person's permissions and StudioOS holds no credential that can read a
# studio's books. If FRAPPE_API_KEY reappears in this file, something has
# regressed.
#
# Generate each of the three with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# REGISTRY_KEY  encrypts tenant client secrets before they are written to KV.
#               Losing it means every studio must reconnect; leaking it exposes
#               every studio's client secret.
# SESSION_KEY   seals the sign-in round-trip cookie, which carries the PKCE
#               verifier. Rotating it logs everyone out; nothing worse.
# CONNECTOR_SHARED_SECRET  gates POST /auth/register so only the connector app
#               can add a tenant. Without it anyone could point StudioOS at a
#               site of their choosing.

REGISTRY_KEY = "32_random_bytes_base64"
SESSION_KEY = "32_random_bytes_base64"
CONNECTOR_SHARED_SECRET = "a_long_random_string"
